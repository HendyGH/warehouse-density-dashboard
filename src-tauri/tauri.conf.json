{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warehouse Dashboard v35",
  "version": "1.0.0",
  "identifier": "com.hendy.warehouse.v35",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Warehouse Dashboard v35",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./Microsoft.WebView2.FixedVersionRuntime/"
      }
    }
  }
}
